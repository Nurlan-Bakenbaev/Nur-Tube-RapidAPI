rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /videos/{videoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 320
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
